{
  "name": "vs-hype-hedge-matcher",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "本地 VS × Hype 只读行情、双账本决策与情景回放工作台",
  "scripts": {
    "start": "node scripts/serve.js",
    "test": "node --test",
    "test:browser": "node scripts/browser-acceptance.js",
    "test:verdict": "node scripts/qa/verdict-refresh.js",
    "test:vest": "node scripts/qa/vest-auto.js && node scripts/qa/vest-public.js && node scripts/qa/vest-fx.js",
    "build:trade": "node scripts/build-trade-extension.js",
    "trade": "node scripts/open-trade.js",
    "test:trade": "node scripts/qa/trade-ui.js && node scripts/qa/trade-hype.js",
    "hedge": "node scripts/serve.js --hedge",
    "test:hedge": "node --test tests/hedge-*.test.js",
    "test:hedge:browser": "node scripts/qa/hedge-browser.js",
    "test:hedge:live": "node scripts/qa/hedge-live.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  }
}
