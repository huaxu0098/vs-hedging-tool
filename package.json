{
  "name": "vs-hype-hedge-matcher",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "基于双边当前快照与公开行情的只读仓位比例计算器",
  "scripts": {
    "start": "node scripts/serve.js --hedge",
    "legacy": "node scripts/serve.js",
    "test": "node --test",
    "test:browser": "node scripts/browser-acceptance.js",
    "test:verdict": "node scripts/qa/verdict-refresh.js",
    "test:vest": "node scripts/qa/vest-auto.js && node scripts/qa/vest-public.js && node scripts/qa/vest-fx.js",
    "build:trade": "node scripts/build-trade-extension.js",
    "trade": "node scripts/open-trade.js",
    "test:trade": "node scripts/qa/trade-ui.js && node scripts/qa/trade-hype.js",
    "paper": "node scripts/serve.js --paper",
    "hedge": "node scripts/serve.js --hedge",
    "test:hedge": "node --test tests/hedge-*.test.js",
    "test:hedge:funding": "node --test tests/hedge-funding-formula.test.js && node scripts/qa/current-funding.js",
    "test:hedge:ranges": "node --test --test-name-pattern='RANGE|PATH|AUTOSEL' tests/hedge-auto.test.js && node scripts/qa/current-ranges.js",
    "test:hedge:dyn": "node --test --test-name-pattern=DYN tests/hedge-auto.test.js && node scripts/qa/current-dynamics.js",
    "test:hedge:vest": "node --test tests/hedge-vest-intake.test.js && node scripts/qa/current-vest-intake.js",
    "test:hedge:perp": "node --test tests/hedge-fx.test.js && node scripts/qa/current-product.js && node scripts/qa/current-stability.js",
    "test:hedge:fx": "node --test tests/hedge-fx.test.js && node scripts/qa/current-fx.js",
    "test:hedge:opt": "node scripts/qa/current-optimization.js",
    "test:hedge:browser": "node scripts/qa/current-live.js",
    "test:hedge:internal": "node scripts/qa/hedge-browser.js",
    "test:hedge:live": "node scripts/qa/hedge-live.js",
    "hedge:observe": "node scripts/read-hedge-tabs.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  }
}
